# Copy to a disposable CODEX_HOME/config.toml and replace @BASE_URL@ with the
# loopback base_url printed by mock_responses_server.py.
model = "fixture-model"
model_provider = "fixture_router"
model_reasoning_effort = "medium"
approval_policy = "never"
# The deterministic loopback router emits only host-selected bounded delays and
# one fixed marker create/read/remove plus `git status` proof. Use this without
# a platform sandbox only in a fresh standalone disposable `/tmp` Git fixture;
# never point it at a live repository or provider.
sandbox_mode = "danger-full-access"

[features]
workflow = true

[model_providers.fixture_router]
name = "Dynamic Workflows control UAT router"
base_url = "@BASE_URL@"
wire_api = "responses"
requires_openai_auth = false
request_max_retries = 0
stream_max_retries = 0
supports_websockets = false
